# GOOGLE_CLOUD_SPEECH_API_KEY: Google Cloud Speech-to-Text API key for Bangla voice recognition.
# Users configure this via the Secrets panel in the AI Studio UI.
GOOGLE_CLOUD_SPEECH_API_KEY=MY_GOOGLE_CLOUD_SPEECH_API_KEY

# GEMINI_API_KEY: Optional alternative for Gemini AI transcription.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY
