{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile and shopkeeper configuration",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Google Auth UID" },
        "email": { "type": "string", "description": "Google account email" },
        "displayName": { "type": "string", "description": "Google display name" },
        "shopName": { "type": "string", "description": "Shop business name" },
        "ownerName": { "type": "string", "description": "Proprietor name" },
        "bkashNumber": { "type": "string", "description": "bKash account" },
        "nagadNumber": { "type": "string", "description": "Nagad account" },
        "lastBackupAt": { "type": "string", "description": "Timestamp of last cloud sync" },
        "autoBackupEnabled": { "type": "boolean", "description": "Whether cloud sync is active" },
        "createdAt": { "type": "string", "description": "Account created timestamp" },
        "updatedAt": { "type": "string", "description": "Account updated timestamp" }
      },
      "required": ["userId", "email"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer record for credit ledger",
      "type": "object",
      "properties": {
        "customerId": { "type": "string", "description": "Local ID or UUID" },
        "userId": { "type": "string", "description": "Owner UID" },
        "name": { "type": "string", "description": "Customer name" },
        "phone": { "type": "string", "description": "Customer contact number" },
        "balance": { "type": "number", "description": "Current outstanding balance" },
        "trustScore": { "type": "number", "description": "Payment reliability score (1-3)" },
        "dueDate": { "type": "number", "description": "Promise due timestamp in ms" },
        "note": { "type": "string", "description": "Additional note" },
        "lastTransactionAt": { "type": "number", "description": "Timestamp in ms" },
        "updatedAt": { "type": "string", "description": "Last updated" }
      },
      "required": ["userId", "name"]
    },
    "TransactionRecord": {
      "title": "TransactionRecord",
      "description": "Ledger entry transaction",
      "type": "object",
      "properties": {
        "transactionId": { "type": "string", "description": "Local ID or UUID" },
        "userId": { "type": "string", "description": "Owner UID" },
        "customerId": { "type": "number", "description": "Associated customer ID" },
        "customerName": { "type": "string", "description": "Customer name at time of entry" },
        "type": { "type": "string", "description": "BAKI_SALE, REPAYMENT, or CASH_SALE" },
        "amount": { "type": "number", "description": "Transaction amount in BDT" },
        "originalSpokenText": { "type": "string", "description": "Original Bangla voice recording" },
        "note": { "type": "string", "description": "Note / items description" },
        "timestamp": { "type": "number", "description": "Transaction timestamp in ms" },
        "dueDate": { "type": "number", "description": "Promised due date in ms" }
      },
      "required": ["userId", "customerName", "type", "amount"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile with store metadata and backup status"
    },
    "/users/{userId}/customers/{customerId}": {
      "schema": "Customer",
      "description": "Scoped customer ledger accounts belonging to the authenticated shopkeeper"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "TransactionRecord",
      "description": "Scoped transaction entries for the shopkeeper"
    }
  }
}
