{
  "firestore": [
    {
      "database": "ai-studio-android-bakibond-808f1a4f-3d29-430d-9667-647c12547480",
      "rules": "firestore.rules"
    }
  ],
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(apk)",
        "headers": [
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"bakibondhu-v2.0.0.apk\""
          },
          {
            "key": "Content-Type",
            "value": "application/vnd.android.package-archive"
          }
        ]
      }
    ]
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8085
    },
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "ui": {
      "enabled": false
    }
  }
}
